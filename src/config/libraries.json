      "exampleTerm": "HAHN001_A549_96H_A03_AKT1 up",
      "parsedExample": { "batch": "HAHN001", "cellLine": "A549", "timepoint": "96H", "batch2": "A03", "perturbation": "AKT1", "direction": "up" }
    },
    "perturbatlas": {
      "displayName": "PerturbAtlas",
      "category": "gene",
      "termFormat": {
        "delimiter": "_",
        "fields": ["prefix", "id", "perturbationType", "perturbation", "dataset"],
