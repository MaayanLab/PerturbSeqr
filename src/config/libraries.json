{
  "libraries": {
    "lincs-l1000-cp": {
      "displayName": "LINCS L1000 CP",
      "category": "drug",
      "source": "https://maayanlab.cloud/sigcom-lincs/#/Download",
      "sourceNote": "LINCS L1000 chemical perturbations (pruned, top 250 by CD coefficient). 156,926 signatures.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["batch", "cellLine", "timepoint", "batch2", "perturbation", "concentration"],
        "optional": []
      },
      "exampleTerm": "ABY001_A375_XH_A13_afatinib_10uM up",
      "parsedExample": { "batch": "ABY001", "cellLine": "A375", "timepoint": "XH", "batch2": "A13", "perturbation": "afatinib", "concentration": "10uM", "direction": "up" }
    },
    "lincs-l1000-xpr": {
      "displayName": "LINCS L1000 XPR",
      "category": "gene",
      "source": "https://maayanlab.cloud/sigcom-lincs/#/Download",
      "sourceNote": "L2S2/SigCom LINCS CRISPR knockouts. 281,890 signatures from LINCS L1000 experiments.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["batch", "cellLine", "timepoint", "batch2", "perturbation"],
        "optional": []
      },
      "exampleTerm": "HAHN001_A549_96H_A03_AKT1 up",
      "parsedExample": { "batch": "HAHN001", "cellLine": "A549", "timepoint": "96H", "batch2": "A03", "perturbation": "AKT1", "direction": "up" }
    },
    "cm4ai": {
      "displayName": "CM4AI",
      "category": "gene",
      "source": "https://cm4ai.org",
      "sourceNote": "Cell Maps for AI gene perturbation signatures.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation"],
        "optional": []
      },
      "exampleTerm": "GENE1 up",
      "parsedExample": { "perturbation": "GENE1", "direction": "up" }
    },
    "tahoe-100m": {
      "displayName": "Tahoe-100M",
      "category": "drug",
      "source": "https://huggingface.co/datasets/tahoebio/Tahoe-100M",
      "sourceNote": "Tahoe Bio Tahoe-100M dataset. 379 drugs across 72 cell lines with concentration data.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "concentration", "cellLine"],
        "optional": [],
        "fixedValues": {
          "timepoint": "24h"
        }
      },
      "exampleTerm": "(R)-Verapamil (hydrochloride)_0.05uM_A-172 up",
      "parsedExample": { "perturbation": "(R)-Verapamil (hydrochloride)", "concentration": "0.05uM", "cellLine": "A-172", "timepoint": "24h", "direction": "up" }
    },
    "microarrays-cmap": {
      "displayName": "Microarrays CMap",
      "category": "drug",
      "source": "https://maayanlab.cloud/Harmonizome/dataset/CMAP+Signatures+of+Differentially+Expressed+Genes+for+Small+Molecules",
      "sourceNote": "Connectivity Map Build 02 (Lamb et al. 2006). Reprocessed from Harmonizome with full experimental metadata. 1,309 drugs across 5 cell lines.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "concentration", "cellLine", "timepoint", "batch"],
        "optional": []
      },
      "exampleTerm": "metformin_10uM_MCF7_6h_batch1 up",
      "parsedExample": { "perturbation": "metformin", "concentration": "10uM", "cellLine": "MCF7", "timepoint": "6h", "batch": "batch1", "direction": "up" }
    },
    "nibr-drug-seq": {
      "displayName": "NIBR DRUG-seq",
      "category": "drug",
      "source": "https://github.com/Novartis/DRUG-seq/tree/main/data/Novartis_drugseq_U2OS_MoABox",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "nsn", "batch", "concentration", "timepoint"],
        "optional": [],
        "fixedValues": {
          "cellLine": "U2OS"
        }
      },
      "unknownTerms": {
        "note": "~12% of compounds are from Novartis internal screening library. If perturbation is empty, display nsn (e.g., AF-80-QK39) instead and hide PubChem link.",
        "fallbackField": "nsn"
      },
      "exampleTerm": "Diphenidol_AF-80-QK39_batchid1_0.01uM_24h up",
      "parsedExample": { "perturbation": "Diphenidol", "nsn": "AF-80-QK39", "batch": "batchid1", "concentration": "0.01uM", "timepoint": "24h", "cellLine": "U2OS", "direction": "up" }
    },
    "sciplex": {
      "displayName": "SciPlex",
      "category": "drug",
      "termFormat": {
        "delimiter": "_",
        "fields": ["cellLine", "perturbation", "concentration", "timepoint"],
        "optional": []
      },
      "exampleTerm": "A549_2-Methoxyestradiol_100nM_24h up",
      "parsedExample": { "cellLine": "A549", "perturbation": "2-Methoxyestradiol", "concentration": "100nM", "timepoint": "24h", "direction": "up" }
    },
    "deepcover-moa": {
      "displayName": "DeepCover MoA",
      "category": "drug",
      "source": "https://wren.hms.harvard.edu/DeepCoverMOA/",
      "sourceNote": "Proteome-wide atlas of drug mechanism of action. Mitchell et al., Nature Biotechnology 2023. PMID:36593396. Raw data: MassIVE MSV000089282.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation"],
        "optional": [],
        "fixedValues": {
          "cellLine": "HCT116",
          "timepoint": "24h",
          "concentration": "10µM"
        }
      },
      "exampleTerm": "(4-Chlorobenzyl)pyridine up",
      "parsedExample": { "perturbation": "(4-Chlorobenzyl)pyridine", "cellLine": "HCT116", "timepoint": "24h", "concentration": "10µM", "direction": "up" }
    },
    "geo-chem": {
      "displayName": "GEO-Chem",
      "category": "drug",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "organism", "platform", "dataset"],
        "optional": ["platform", "dataset"]
      },
      "exampleTerm": "fluoxetine_mus musculus_gpl1261_gds2803 up",
      "parsedExample": { "perturbation": "fluoxetine", "organism": "mus musculus", "platform": "gpl1261", "dataset": "gds2803", "direction": "up" }
    },
    "rummageo-chem": {
      "displayName": "RummaGEO Chem",
      "category": "drug",
      "source": "https://rummageo.com",
      "sourceNote": "Automatically mined drug perturbation signatures from GEO RNA-seq. Marino et al. 2024 Patterns.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["gse", "sampleA", "v", "sampleB", "perturbation", "organism"],
        "optional": []
      },
      "metadataLookup": {
        "file": "rummageo_metadata.json",
        "keyBuilder": ["gse", "sampleA"],
        "fields": ["cell_line", "cell_type", "timepoint", "tissue", "title"]
      },
      "exampleTerm": "GSE100217_1_v_0_ethanol_mouse up",
      "parsedExample": { "gse": "GSE100217", "sampleA": "1", "v": "v", "sampleB": "0", "perturbation": "ethanol", "organism": "mouse", "direction": "up" }
    },
    "ginkgo-bioworks": {
      "displayName": "Ginkgo Bioworks",
      "category": "drug",
      "termFormat": {
        "delimiter": "-",
        "fields": ["cellLine", "perturbation", "concentration", "timepoint"],
        "optional": [],
        "joinMiddle": true,
        "fieldsFromEnd": 2
      },
      "exampleTerm": "human_dermal_fibroblast-(S)-(+)-Camptothecin-3000-24 up",
      "parsedExample": { "cellLine": "human_dermal_fibroblast", "perturbation": "(S)-(+)-Camptothecin", "concentration": "3000", "timepoint": "24", "direction": "up" }
    },
    "perturb-atlas": {
      "displayName": "Perturb Atlas",
      "category": "gene",
      "source": "https://maayanlab.cloud/Harmonizome/dataset/PerturbAtlas+Signatures+of+Differentially+Expressed+Genes+for+Gene+Perturbations",
      "sourceNote": "Gene expression profiles following genetic perturbation (KD/KO/OE/Mut). Zhang et al. 2024 Nucleic Acids Res. Reprocessed from Harmonizome.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["prefix", "id", "perturbationType", "perturbation", "dataset"],
        "optional": []
      },
      "metadataLookup": {
        "file": "perturbatlas_metadata.json",
        "keyBuilder": ["prefix", "id"],
        "fields": ["cell_line", "cell_type", "condition", "disease", "study_accession"]
      },
      "exampleTerm": "Perturb_10000_KD_CPSF6_SRP013565 up",
      "parsedExample": { "prefix": "Perturb", "id": "10000", "perturbationType": "KD", "perturbation": "CPSF6", "dataset": "SRP013565", "direction": "up" }
    },
    "perturb-atlas-mouse": {
      "displayName": "Perturb Atlas Mouse",
      "category": "gene",
      "source": "https://maayanlab.cloud/Harmonizome/dataset/PerturbAtlas+Signatures+of+Differentially+Expressed+Genes+for+Mouse+Gene+Perturbations",
      "sourceNote": "Mouse gene expression profiles following genetic perturbation (KD/KO/OE/Mut). Zhang et al. 2024 Nucleic Acids Res. Reprocessed from Harmonizome.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["prefix", "id", "perturbationType", "perturbation", "dataset"],
        "optional": []
      },
      "metadataLookup": {
        "file": "perturbatlas_metadata.json",
        "keyBuilder": ["prefix", "id"],
        "fields": ["cell_line", "cell_type", "condition", "disease", "study_accession"]
      },
      "exampleTerm": "Perturb_1001_KO_Adar1_SRP360154 up",
      "parsedExample": { "prefix": "Perturb", "id": "1001", "perturbationType": "KO", "perturbation": "Adar1", "dataset": "SRP360154", "direction": "up" }
    },
    "geo-gene": {
      "displayName": "GEO-Gene",
      "category": "gene",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "perturbationType", "dataset", "batch", "organism", "tissue"],
        "optional": ["tissue"]
      },
      "exampleTerm": "NIX_Deficiency_GDS2630_160_mouse_spleen up",
      "parsedExample": { "perturbation": "NIX", "perturbationType": "Deficiency", "dataset": "GDS2630", "batch": "160", "organism": "mouse", "tissue": "spleen", "direction": "up" }
    },
    "rummageo-gene": {
      "displayName": "RummaGEO Gene",
      "category": "gene",
      "source": "https://rummageo.com",
      "sourceNote": "Automatically mined gene perturbation signatures from GEO RNA-seq. Marino et al. 2024 Patterns.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["gse", "sampleA", "v", "sampleB", "perturbation", "organism"],
        "optional": []
      },
      "metadataLookup": {
        "file": "rummageo_metadata.json",
        "keyBuilder": ["gse", "sampleA"],
        "fields": ["cell_line", "cell_type", "timepoint", "tissue", "title"]
      },
      "exampleTerm": "GSE100102_0_v_5_cgas_mouse up",
      "parsedExample": { "gse": "GSE100102", "sampleA": "0", "v": "v", "sampleB": "5", "perturbation": "cgas", "organism": "mouse", "direction": "up" }
    },
    "replogle-perturb-seq-k562-essential": {
      "displayName": "Replogle et al. K562 Essential",
      "category": "gene",
      "source": "https://maayanlab.cloud/Harmonizome/dataset/Replogle+et+al.,+Cell,+2022+K562+Essential+Perturb-seq+Gene+Perturbation+Signatures",
      "sourceNote": "Gene expression profiles in K562 cells following CRISPRi perturbation of essential genes. Replogle et al., Cell, 2022. Reprocessed from Harmonizome.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["id", "perturbation", "batch"],
        "optional": [],
        "fixedValues": {
          "cellLine": "K562"
        }
      },
      "exampleTerm": "10023_ZC3H18_P1P2 up",
      "parsedExample": { "id": "10023", "perturbation": "ZC3H18", "batch": "P1P2", "direction": "up" }
    },
    "replogle-perturb-seq-k562-genomewide": {
      "displayName": "Replogle et al. K562 Genome-wide",
      "category": "gene",
      "source": "https://maayanlab.cloud/Harmonizome/dataset/Replogle+et+al.,+Cell,+2022+K562+Genome-wide+Perturb-seq+Gene+Perturbation+Signatures",
      "sourceNote": "Gene expression profiles in K562 cells following CRISPRi perturbation genome-wide. Replogle et al., Cell, 2022. Reprocessed from Harmonizome.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["id", "perturbation", "batch"],
        "optional": [],
        "fixedValues": {
          "cellLine": "K562"
        }
      },
      "exampleTerm": "10005_ZBTB4_P1 up",
      "parsedExample": { "id": "10005", "perturbation": "ZBTB4", "batch": "P1", "direction": "up" }
    },
    "replogle-perturb-seq-rpe1-essential": {
      "displayName": "Replogle et al. RPE1 Essential",
      "category": "gene",
      "source": "https://maayanlab.cloud/Harmonizome/dataset/Replogle+et+al.,+Cell,+2022+RPE1+Essential+Perturb-seq+Gene+Perturbation+Signatures",
      "sourceNote": "Gene expression profiles in RPE1 cells following CRISPRi perturbation of essential genes. Replogle et al., Cell, 2022. Reprocessed from Harmonizome.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["id", "perturbation", "batch"],
        "optional": [],
        "fixedValues": {
          "cellLine": "RPE1"
        }
      },
      "exampleTerm": "10005_ZBTB4_P1 up",
      "parsedExample": { "id": "10005", "perturbation": "ZBTB4", "batch": "P1", "direction": "up" }
    }
  }
}
