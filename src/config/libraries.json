{
  "libraries": {
    "tahoe-100m": {
      "displayName": "Tahoe-100M",
      "category": "drug",
      "source": "https://huggingface.co/datasets/tahoebio/Tahoe-100M",
      "sourceNote": "Tahoe Bio Tahoe-100M dataset. 379 drugs across 72 cell lines with concentration data.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "concentration", "cellLine"],
        "optional": [],
        "fixedValues": {
          "timepoint": "24h"
        }
      },
      "exampleTerm": "(R)-Verapamil (hydrochloride)_0.05uM_A-172 up",
      "parsedExample": { "perturbation": "(R)-Verapamil (hydrochloride)", "concentration": "0.05uM", "cellLine": "A-172", "timepoint": "24h", "direction": "up" }
    },
    "l1000-cp": {
      "displayName": "L1000-CP",
      "category": "drug",
      "source": "https://maayanlab.cloud/sigcom-lincs/#/Download",
      "sourceNote": "L2S2/SigCom LINCS chemical perturbations. 1,436,110 signatures from LINCS L1000 experiments.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["batch", "cellLine", "timepoint", "batch2", "perturbation", "concentration"],
        "optional": []
      },
      "exampleTerm": "ABY001_A375_XH_A13_afatinib_10uM up",
      "parsedExample": { "batch": "ABY001", "cellLine": "A375", "timepoint": "XH", "batch2": "A13", "perturbation": "afatinib", "concentration": "10uM", "direction": "up" }
    },
    "cmap-build02": {
      "displayName": "CMAP-Build02",
      "category": "drug",
      "source": "https://maayanlab.cloud/Harmonizome/dataset/CMAP+Signatures+of+Differentially+Expressed+Genes+for+Small+Molecules",
      "sourceNote": "Connectivity Map Build 02 (Lamb et al. 2006). Reprocessed from Harmonizome with full experimental metadata. 1,309 drugs across 5 cell lines.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "concentration", "cellLine", "timepoint", "batch"],
        "optional": []
      },
      "exampleTerm": "metformin_10uM_MCF7_6h_batch1 up",
      "parsedExample": { "perturbation": "metformin", "concentration": "10uM", "cellLine": "MCF7", "timepoint": "6h", "batch": "batch1", "direction": "up" }
    },
    "drugseqr": {
      "displayName": "DRUGseqr",
      "category": "drug",
      "source": "https://github.com/Novartis/DRUG-seq/tree/main/data/Novartis_drugseq_U2OS_MoABox",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "nsn", "batch", "concentration", "timepoint"],
        "optional": [],
        "fixedValues": {
          "cellLine": "U2OS"
        }
      },
      "unknownTerms": {
        "note": "~12% of compounds are from Novartis internal screening library. If perturbation is empty, display nsn (e.g., AF-80-QK39) instead and hide PubChem link.",
        "fallbackField": "nsn"
      },
      "exampleTerm": "Diphenidol_AF-80-QK39_batchid1_0.01uM_24h up",
      "parsedExample": { "perturbation": "Diphenidol", "nsn": "AF-80-QK39", "batch": "batchid1", "concentration": "0.01uM", "timepoint": "24h", "cellLine": "U2OS", "direction": "up" }
    },
    "sciplex": {
      "displayName": "SciPlex",
      "category": "drug",
      "termFormat": {
        "delimiter": "_",
        "fields": ["cellLine", "perturbation", "concentration", "timepoint"],
        "optional": []
      },
      "exampleTerm": "A549_2-Methoxyestradiol_100nM_24h up",
      "parsedExample": { "cellLine": "A549", "perturbation": "2-Methoxyestradiol", "concentration": "100nM", "timepoint": "24h", "direction": "up" }
    },
    "deepcovermoa": {
      "displayName": "DeepCoverMoA",
      "category": "drug",
      "source": "https://wren.hms.harvard.edu/DeepCoverMOA/",
      "sourceNote": "Proteome-wide atlas of drug mechanism of action. Mitchell et al., Nature Biotechnology 2023. PMID:36593396. Raw data: MassIVE MSV000089282.",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation"],
        "optional": [],
        "fixedValues": {
          "cellLine": "HCT116",
          "timepoint": "24h",
          "concentration": "10µM"
        }
      },
      "exampleTerm": "(4-Chlorobenzyl)pyridine up",
      "parsedExample": { "perturbation": "(4-Chlorobenzyl)pyridine", "cellLine": "HCT116", "timepoint": "24h", "concentration": "10µM", "direction": "up" }
    },
    "geo-chem": {
      "displayName": "GEO-Chem",
      "category": "drug",
      "termFormat": {
        "delimiter": "_",
        "fields": ["perturbation", "organism", "platform", "dataset"],
        "optional": ["platform", "dataset"]
      },
      "exampleTerm": "fluoxetine_mus musculus_gpl1261_gds2803 up",
      "parsedExample": { "perturbation": "fluoxetine", "organism": "mus musculus", "platform": "gpl1261", "dataset": "gds2803", "direction": "up" }
    },
    "ginkgo": {
      "displayName": "Ginkgo",
      "category": "drug",
      "termFormat": {
        "delimiter": "-",
        "fields": ["cellLine", "perturbation", "concentration", "timepoint"],
        "optional": [],
        "joinMiddle": true,
        "fieldsFromEnd": 2
      },
      "exampleTerm": "human_dermal_fibroblast-(S)-(+)-Camptothecin-3000-24 up",
      "parsedExample": { "cellLine": "human_dermal_fibroblast", "perturbation": "(S)-(+)-Camptothecin", "concentration": "3000", "timepoint": "24", "direction": "up" }
    },
    "l1000-xpr": {
      "displayName": "L1000-XPR",
      "category": "gene",
      "source": "https://maayanlab.cloud/sigcom-lincs/#/Download",
