POSTGRES_PASSWORD=postgres
MINIO_ROOT_PASSWORD=minioadmin
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
S3_URL=http://minio:minioadmin@perturbseqr-minio:9000/data
PUBLIC_S3_URL=http://localhost:9000/data

# PUBLIC_S3_URL by deployment target:
#   local: http://localhost:9000/data
#   dev:   https://s3.perturbseqr.k8s.maayanlab.cloud/data
#   prod:  https://perturbseqr.s3.amazonaws.com

NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional S3-compatible sources; uncomment to override the local MinIO defaults.
# Use the service endpoint here, with the bucket name supplied separately.
# INGEST_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# INGEST_S3_BUCKET=perturbseqr
# ENRICH_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# ENRICH_S3_BUCKET=perturbseqr
# ENRICH_S3_PREFIX=enrich/production/
# For local AWS tests, use a unique enrich/local-test-<run-id>/ prefix instead.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Set AWS_SESSION_TOKEN only for temporary credentials; otherwise leave it unset.
