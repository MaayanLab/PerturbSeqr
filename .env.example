# Local/production: AWS S3. For the dev cluster, use .env.dev.example instead.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
PUBLIC_S3_URL=https://perturbseqr.s3.amazonaws.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Use the service endpoint here, with the bucket name supplied separately.
INGEST_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
INGEST_S3_BUCKET=perturbseqr
ENRICH_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
ENRICH_S3_BUCKET=perturbseqr
# Local: replace your-name with a unique identifier for this database.
# Production: change to enrich/production/. Keep local and production separate.
ENRICH_S3_PREFIX=enrich/local-your-name/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set AWS_SESSION_TOKEN only for temporary credentials; otherwise leave it unset.

# Legacy MinIO service remains in compose during the AWS cutover.
# These settings do not select the ingest/enrichment backend above.
MINIO_ROOT_PASSWORD=minioadmin
S3_URL=http://minio:minioadmin@perturbseqr-minio:9000/data
